{
  "name": "@cmx666/dsh-niu-bundle",
  "description": "DeepSeek Harness profile bundle that enables Niubash sandbox and tool-bash on Windows",
  "version": "0.2.1-rc.1",
  "type": "module",
  "main": "cordis.patch.yml",
  "files": [
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "README.md",
    "README.zh.md",
    "package.json"
  ],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caomengxuan666/dsh-niu.git",
    "directory": "packages/bundle/niu"
  },
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@cmx666/dsh-niu-local": "^0.2.0-rc.1",
    "@cmx666/dsh-niu-sandbox": "^0.2.1-rc.1",
    "@cmx666/dsh-client-ui-niu": "^0.2.0-rc.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2"
  }
}
